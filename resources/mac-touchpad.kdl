// Merge these settings into your config, or include this file from config.kdl.
// Requires niri built with libinput >= 1.28 and a supporting touchpad.
input {
    touchpad {
        three-finger-drag true
        natural-scroll
    }
}

gestures {
    // Four fingers: vertical workspace switching, horizontal window focus.
    workspace-switch-fingers 4
    workspace-switch-axis "vertical"
    view-scroll-fingers 0
    overview-fingers 0
    swipe-threshold 8
    pinch-threshold 1
    pinch-sensitivity 2.5

    swipe fingers=4 direction="left" { focus-column-right; }
    swipe fingers=4 direction="right" { focus-column-left; }
    // View transitions follow the fingers, including reversing before release.
    // In grid, spread to exit; in overview, pinch inward to exit.
    pinch fingers=4 direction="in" { open-grid-overview; }
    pinch fingers=4 direction="out" { open-overview; }
    // Grid shows the workspace's windows, not only the current application's windows.

    // Mod + two-finger dragging resizes the window under the pointer.
    // Remove old four-finger up/down swipe bindings from your config: they
    // otherwise take precedence over workspace switching.
}
