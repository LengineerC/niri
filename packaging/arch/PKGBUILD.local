pkgname=niri-shorin-fork-git
pkgver=26.04.r115.g42a2e06.portal3
pkgrel=14
pkgdesc='Niri Shorin fork with native ScreenCast and Screenshot portal APIs (local checkout)'
arch=('x86_64')
url='https://github.com/SHORiN-KiWATA/niri'
license=('GPL-3.0-or-later')
depends=('cairo' 'glib2' 'libdisplay-info' 'libinput' 'libpipewire' 'libxkbcommon' 'mesa' 'pango' 'pixman' 'seatd' 'xdg-desktop-portal')
makedepends=('clang' 'rust')
optdepends=('pipewire: PipeWire daemon for screen casting'
            'xdg-desktop-portal-gtk: file chooser and other portal interfaces'
            'gnome-keyring: Secret portal backend')
provides=("niri=$pkgver" "niri-git=$pkgver")
conflicts=('niri' 'niri-git' 'niri-bin')
options=('!debug' '!lto' '!strip')
source=()

_local_src="$(realpath "$startdir/../..")"

build() {
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --manifest-path "$_local_src/Cargo.toml" --locked --release
}

package() {
  install -Dm755 "$srcdir/target/release/niri" -t "$pkgdir/usr/bin/"
  install -Dm755 "$_local_src/resources/niri-session" -t "$pkgdir/usr/bin/"
  install -Dm644 "$_local_src/resources/default-config.kdl" -t "$pkgdir/usr/share/doc/niri/"
  install -Dm644 "$_local_src/resources/niri.desktop" -t "$pkgdir/usr/share/wayland-sessions/"
  install -Dm644 "$_local_src/resources/niri-portals.conf" -t "$pkgdir/usr/share/xdg-desktop-portal/"
  install -Dm644 "$_local_src/resources/niri.portal" -t "$pkgdir/usr/share/xdg-desktop-portal/portals/"
  install -Dm644 "$_local_src/resources/niri.service" \
                 "$_local_src/resources/niri-shutdown.target" \
                 -t "$pkgdir/usr/lib/systemd/user/"
}
